# The Raiden Project native Linux build (static recompilation of the four PS-X EXEs on the disc)
CC      ?= gcc
SDL_CFLAGS ?= $(shell sdl2-config --cflags 2>/dev/null || pkg-config --cflags sdl2 2>/dev/null || echo -I$(HOME)/tools/sdl2/include/SDL2)
SDL_LIBS   ?= $(shell sdl2-config --libs 2>/dev/null || pkg-config --libs sdl2 2>/dev/null || echo -L$(HOME)/tools/sdl2/lib -Wl,-rpath,$(HOME)/tools/sdl2/lib -lSDL2)
DISC    ?= $(shell ls disc/*.bin 2>/dev/null | head -n 1)
CFLAGS  ?= -O2 -g
CFLAGS  += $(EXTRA) $(SDL_CFLAGS) -Iruntime -fno-strict-aliasing -fwrapv -Wall -Wno-unused-variable -Wno-misleading-indentation
GENFLAGS = $(CFLAGS) -Wno-unused-label -Wno-unused-but-set-variable -foptimize-sibling-calls
LDLIBS   = $(SDL_LIBS) -lz -lm -lpthread

# program name : EXE path on the disc (relative to extracted/)
PROGS   = scus jj2h jj2v jj3
EXE_scus = SCUS_944.02
EXE_jj2h = JJ2X/PSJJ2H.EXE
EXE_jj2v = JJ2X/PSJJ2V.EXE
EXE_jj3  = JJ3X/PSJJ3.EXE

RUNTIME = $(wildcard runtime/*.c)
RTOBJ   = $(RUNTIME:%.c=build/%.o)
# generated by tools/recomp.py -- not in git, built from your own disc
GENSTAMP = $(PROGS:%=gen/%.stamp)

all: raiden

extract:
	@test -n "$(DISC)" || (echo "put 'Raiden Project, The (USA).bin/.cue' in disc/ first" && false)
	mkdir -p extracted
	python3 -I tools/extract_iso.py "$(DISC)" extracted

extracted/SCUS_944.02:
	$(MAKE) extract

define PROG_RULE
gen/$(1).stamp: tools/recomp.py extracted/SCUS_944.02 analysis/rea_$(1).txt $(wildcard analysis/extra_$(1).txt) $(wildcard analysis/patch_$(1).c)
	@mkdir -p gen
	python3 -I tools/recomp.py $(1) $$(EXE_$(1))
	@touch $$@
endef
$(foreach p,$(PROGS),$(eval $(call PROG_RULE,$(p))))

# the object list depends on what the recompiler wrote, so link in a second stage
raiden: $(GENSTAMP)
	$(MAKE) --no-print-directory link

GENSRC = $(foreach p,$(PROGS),$(shell cat gen/$(p).files 2>/dev/null))
GENOBJ = $(GENSRC:%.c=build/%.o)
link: $(GENOBJ) $(RTOBJ)
	$(CC) $(CFLAGS) -rdynamic -o raiden $^ $(LDLIBS)

build/runtime/%.o: runtime/%.c runtime/recomp.h runtime/psx.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

build/gen/%.o: gen/%.c runtime/recomp.h
	@mkdir -p $(dir $@)
	$(CC) $(GENFLAGS) -c $< -o $@

clean:
	rm -rf build raiden

.PHONY: all clean extract link raiden
